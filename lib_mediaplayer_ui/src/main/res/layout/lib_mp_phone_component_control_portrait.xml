<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/module_mediaplayer_color_00000000"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false">

    <RelativeLayout
        android:id="@+id/module_mediaplayer_component_phone_control_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="false"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/module_mediaplayer_component_phone_control_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="23dp"
            android:src="@drawable/lib_mp_phone_ic_back" />


        <CheckBox
            android:id="@+id/module_mediaplayer_component_phone_control_portrait_toggle2"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_centerInParent="true"
            android:background="@drawable/lib_mp_phone_selector_ic_toggle"
            android:button="@android:color/transparent"
            android:checked="true" />


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true">

            <CheckBox
                android:id="@+id/module_mediaplayer_component_phone_control_portrait_toggle1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:layout_marginLeft="32dp"
                android:background="@drawable/lib_mp_phone_selector_ic_toggle"
                android:button="@android:color/transparent"
                android:checked="true" />

            <CheckBox
                android:id="@+id/module_mediaplayer_component_phone_control_voice"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:layout_marginLeft="20dp"
                android:layout_toRightOf="@id/module_mediaplayer_component_phone_control_portrait_toggle1"
                android:background="@drawable/lib_mp_phone_selector_ic_voice"
                android:button="@android:color/transparent"
                android:checked="true" />

            <TextView
                android:id="@+id/module_mediaplayer_component_phone_control_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="20dp"
                android:layout_toRightOf="@id/module_mediaplayer_component_phone_control_voice"
                android:background="@android:color/holo_blue_dark"
                android:textSize="20sp" />

            <ImageView
                android:id="@+id/module_mediaplayer_component_phone_control_full"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="32dp"
                android:src="@drawable/lib_mp_phone_ic_full" />

        </RelativeLayout>

        <SeekBar
            android:id="@+id/module_mediaplayer_component_phone_control_portrait_seekbar"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="60dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />

    </RelativeLayout>

</RelativeLayout>